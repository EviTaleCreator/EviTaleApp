{
  "name": "evitale-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-content.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "dev:editor": "node dev.mjs --mode editor",
    "build:editor": "vite build --mode editor",
    "start:editor": "node server.mjs"
  },
  "devDependencies": {
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
